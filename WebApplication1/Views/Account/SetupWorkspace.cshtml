@model WebApplication1.Models.ViewModels.WorkspaceSetupViewModel
@{
    Layout = "_Layout"; 
    ViewData["Title"] = "Workspace Setup";
}

<!-- استخدام نفس كلاس الـ Auth Form مع جعلها نشطة لتأخذ نفس مظهر الكارت الافتراضي -->
<div class="auth-form-section active" id="auth-setup">
    <div class="auth-form-title">Almost there!</div>
    <div class="auth-form-sub">Tell us about your workspace to customize your dashboard</div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger" style="font-size:13px; padding: 10px 14px; border-radius: var(--radius-sm); margin-bottom: 16px; color: #721c24; background-color: #f8d7da; border: 1px solid #f5c6cb;">
            <div asp-validation-summary="All" style="list-style: none; padding: 0; margin: 0;"></div>
        </div>
    }

    <form asp-controller="Account" asp-action="SaveWorkspace" method="post">
        @Html.AntiForgeryToken()

        
        <input type="hidden" asp-for="PendingOwnerId" />
        <input type="hidden" asp-for="FirstName" />
        <input type="hidden" asp-for="LastName" />

        <!-- ══ Section 1: Space Details & Location ══ -->
        <div style="font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; color: var(--primary-blue); margin-bottom: 14px; padding-bottom: 4px; border-bottom: 1px solid var(--border-color);">
            1. Space Details & Location
        </div>

        <div class="auth-field">
            <label asp-for="Name">Workspace Name</label>
            <input type="text" asp-for="Name" placeholder="e.g., SpotIn Hub Dokki" required />
            <span asp-validation-for="Name" style="color: #dc2626; font-size: 12px; margin-top: 4px; display: block;"></span>
        </div>

        <div class="auth-field">
            <label asp-for="Address">Full Address</label>
            <input type="text" asp-for="Address" placeholder="e.g., 14 El-Batal Ahmed Abdel Aziz, Giza" required />
            <span asp-validation-for="Address" style="color: #dc2626; font-size: 12px; margin-top: 4px; display: block;"></span>
        </div>

        <div class="auth-field">
            <label style="margin-bottom: 8px; display: block;">Select Location on Map</label>
            <div id="map" style="height: 250px; width: 100%; border-radius: var(--radius-sm); border: 1px solid var(--border-color); margin-bottom: 12px; z-index: 1;"></div>
        </div>

        <div class="auth-field-row" style="margin-bottom: 16px;">
            <div class="auth-field" style="margin-bottom: 0;">
                <label asp-for="Latitude">Latitude</label>
                <input type="number" step="any" asp-for="Latitude" id="lat-input" readonly required style="background-color: #f1f3f5; cursor: not-allowed;" />
                <span asp-validation-for="Latitude" style="color: #dc2626; font-size: 12px; margin-top: 4px; display: block;"></span>
            </div>
            <div class="auth-field" style="margin-bottom: 0;">
                <label asp-for="Longitude">Longitude</label>
                <input type="number" step="any" asp-for="Longitude" id="lng-input" readonly required style="background-color: #f1f3f5; cursor: not-allowed;" />
                <span asp-validation-for="Longitude" style="color: #dc2626; font-size: 12px; margin-top: 4px; display: block;"></span>
            </div>
        </div>

       <!-- ══ Section 2: Capacity & Pricing ══ -->
        <div style="font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; color: var(--primary-blue); margin: 24px 0 14px 0; padding-bottom: 4px; border-bottom: 1px solid var(--border-color);">
            2. Capacity & Pricing
        </div>

        <div class="auth-field-row" style="margin-bottom: 16px; display: flex; gap: 16px;">
            <div class="auth-field" style="margin-bottom: 0; flex: 1;">
                <label asp-for="TotalTables">Standard Tables</label>
                <input type="number" asp-for="TotalTables" min="0" placeholder="0" required />
                <span asp-validation-for="TotalTables" style="color: #dc2626; font-size: 12px; margin-top: 4px; display: block;"></span>
            </div>
            <div class="auth-field" style="margin-bottom: 0; flex: 1;">
                <label asp-for="TablePricePerHour">Table Price / Hour (EGP)</label>
                <input type="number" step="0.01" asp-for="TablePricePerHour" min="0" placeholder="0.00" required />
                <span asp-validation-for="TablePricePerHour" style="color: #dc2626; font-size: 12px; margin-top: 4px; display: block;"></span>
            </div>
        </div>

        <div class="auth-field-row" style="margin-bottom: 16px; display: flex; gap: 16px;">
            <div class="auth-field" style="margin-bottom: 0; flex: 1;">
                <label asp-for="TotalRooms">Meeting Rooms</label>
                <input type="number" asp-for="TotalRooms" min="0" placeholder="0" required />
                <span asp-validation-for="TotalRooms" style="color: #dc2626; font-size: 12px; margin-top: 4px; display: block;"></span>
            </div>
            <div class="auth-field" style="margin-bottom: 0; flex: 1;">
                <label asp-for="RoomPricePerHour">Room Price / Hour (EGP)</label>
                <input type="number" step="0.01" asp-for="RoomPricePerHour" min="0" placeholder="0.00" required />
                <span asp-validation-for="RoomPricePerHour" style="color: #dc2626; font-size: 12px; margin-top: 4px; display: block;"></span>
            </div>
        </div>

        <!-- ══ Section 3: Amenities ══ -->
        <div style="font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; color: var(--primary-blue); margin: 24px 0 14px 0; padding-bottom: 4px; border-bottom: 1px solid var(--border-color);">
            3. Amenities
        </div>
        
        <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 16px; background: #FAFBFC; padding: 16px; border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
            <div style="display: flex; align-items: center; gap: 10px;">
                <input type="checkbox" asp-for="HasAirConditioning" id="ac" style="width: auto; margin: 0; cursor: pointer;" />
                <label for="ac" style="margin: 0; font-size: 13px; color: var(--navy-dark); font-weight: 500; cursor: pointer;">Air Conditioning (مكيف هواء)</label>
            </div>

            <div style="display: flex; align-items: center; gap: 10px;">
                <input type="checkbox" asp-for="HasWiFi" id="wifi" style="width: auto; margin: 0; cursor: pointer;" />
                <label for="wifi" style="margin: 0; font-size: 13px; color: var(--navy-dark); font-weight: 500; cursor: pointer;">High-Speed WiFi (إنترنت سريع)</label>
            </div>

            <div style="display: flex; align-items: center; gap: 10px;">
                <input type="checkbox" asp-for="HasDrinksAndCafeteria" id="drinks" style="width: auto; margin: 0; cursor: pointer;" />
                <label for="drinks" style="margin: 0; font-size: 13px; color: var(--navy-dark); font-weight: 500; cursor: pointer;">Drinks & Cafeteria (بوفيه مشروبات)</label>
            </div>
        </div>

        <div class="auth-field" style="margin-bottom: 24px;">
            <label asp-for="Description">Description (Optional)</label>
            <textarea asp-for="Description" placeholder="Write any extra details about your space..." rows="3" 
                      style="width: 100%; padding: 10px 13px; border: 1px solid var(--border-color); border-radius: var(--radius-sm); font-size: 14px; font-family: inherit; background: #FAFBFC; color: var(--navy-dark); outline: none; transition: var(--transition); box-sizing: border-box; resize: vertical;"></textarea>
        </div>

        <button type="submit" class="auth-btn-submit">Create Account & Workspace</button>
    </form>

    <div class="auth-form-footer" style="margin-top: 20px;">
        Need help? <a href="#">Contact SpotIn Support</a>
    </div>
</div>


<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
    var defaultLat = 30.0444;
    var defaultLng = 31.2357;

    var latInput = document.getElementById('lat-input');
    var lngInput = document.getElementById('lng-input');

    var existingLat = parseFloat(latInput.value);
    var existingLng = parseFloat(lngInput.value);

    if (!isNaN(existingLat) && !isNaN(existingLng) && existingLat !== 0) {
    defaultLat = existingLat;
    defaultLng = existingLng;
    } else {
    latInput.value = defaultLat;
    lngInput.value = defaultLng;
    }

    var map = L.map('map', {
    fadeAnimation: false,
    zoomAnimation: false,
    inertial: false
    }).setView([defaultLat, defaultLng], 13);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap contributors',
    maxZoom: 18
    }).addTo(map);

    var marker = L.marker([defaultLat, defaultLng], {
    draggable: true
    }).addTo(map);

    function updateInputs(lat, lng) {
    latInput.value = lat.toFixed(6);
    lngInput.value = lng.toFixed(6);
    }

    marker.on('dragend', function (event) {
    var position = marker.getLatLng();
    updateInputs(position.lat, position.lng);
    });

    map.on('click', function (event) {
    var lat = event.latlng.lat;
    var lng = event.latlng.lng;
    marker.setLatLng([lat, lng]);
    updateInputs(lat, lng);
    });

    setTimeout(function () {
    map.invalidateSize(true); 
    map.setView([defaultLat, defaultLng], 7); 
    marker.setLatLng([defaultLat, defaultLng]);
    }, 600);
    });
</script>