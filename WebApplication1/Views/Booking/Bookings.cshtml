@model IEnumerable<Booking>
@{
    Layout = "_OwnerLayout";
    ViewData["Title"] = "Bookings";
    ViewData["PageTitle"] = "Bookings";
    ViewData["Breadcrumb"] = "SpotIN · Owner Portal . Bookings";
}

<div class="container-fluid px-4 py-4">
    <div class="card shadow-sm border-0 rounded-3 bg-white overflow-hidden">
        <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center px-4 py-3 border-bottom">
            <h5 class="text-dark fw-bold mb-0"><i class="bi bi-list-task text-primary me-2"></i>Incoming Booking Requests</h5>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fw-bold">
                Total Requests: @Model.Count()
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0 text-dark">
                    <thead class="table-light text-secondary fw-bold ">
                        <tr>
                            <th class="ps-4">Booking ID</th>
                            <th>Customer Name</th>
                            <th>Resource / Space</th>
                            <th>Start Time</th>
                            <th>End Time</th>
                            <th>Current Status</th>
                            <th class="text-center pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr id="row-@item.Id">
                                <td class="ps-4 text-secondary fw-bold">#@item.Id</td>
                                <td class="fw-semibold text-dark">@(item.User?.UserName ?? "Guest Client")</td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="fw-bold text-dark">@(item.Resourse?.Name ?? "General Slot")</span>
                                        <small class="text-muted small">@(item.Resourse?.WorkSpace?.Name ?? "Main Branch")</small>
                                    </div>
                                </td>
                                <td class="text-secondary small">@item.StartTime.ToString("yyyy-MM-dd hh:mm tt")</td>
                                <td class="text-secondary small">@(item.EndTime.HasValue ? item.EndTime.Value.ToString("yyyy-MM-dd hh:mm tt") : "Open Session")</td>
                                <td>
                                    <span id="badge-@item.Id" class="badge px-2 py-1 rounded-2 small fw-semibold
                                        @(item.Status == "Active" ? "bg-success-subtle text-success border border-success" :
                                                                                                        item.Status == "Cancelled" ? "bg-danger-subtle text-danger border border-danger" :
                                                                                                        "bg-warning-subtle text-warning border border-warning")">
                                        @item.Status
                                    </span>
                                </td>
                                <td class="text-center pe-4">
                                    @if (item.Status != "Active" && item.Status != "Cancelled")
                                    {
                                        <div class="d-flex gap-2 justify-content-center" id="actions-@item.Id">
                                            <button type="button" class="btn btn-sm btn-success px-3 rounded-2 fw-semibold btn-accept" data-id="@item.Id" asp-controller="Booking" asp-action="AcceptBooking">
                                                Accept
                                            </button>
                                            <button type="button" class="btn btn-sm btn-danger px-3 rounded-2 fw-semibold btn-reject" data-id="@item.Id" asp-controller="Booking" asp-action="RejectBooking">
                                                Reject
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small italic">Processed</span>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-5 bg-white">
                                    <div class="py-4">
                                        <i class="bi bi-calendar-x fs-1 text-secondary opacity-50 d-block mb-3"></i>
                                        <h6 class="fw-semibold text-dark">No New Bookings</h6>
                                        <p class="text-muted small mb-0">Everything looks cleared up! New client applications will appear here.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        $(document).ready(function () {
        
        $('.btn-accept').on('click', function () {
        var button = $(this);
        var id = button.data('id');
        var actionUrl = button.attr('formaction'); 

        Swal.fire({
        title: 'Confirm Acceptance?',
        text: "This will approve the user's booking request.",
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#198754',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Yes, Accept!'
        }).then((result) => {
        if (result.isConfirmed) {
        $.ajax({
        url: actionUrl,
        type: 'POST',
        data: { id: id },
        success: function (response) {
        if (response.success) {
        Swal.fire('Accepted!', response.message, 'success');
        $('#badge-' + id).removeClass().addClass('badge px-2 py-1 rounded-2 small fw-semibold bg-success-subtle text-success border border-success').text('Active');
        $('#actions-' + id).html('<span class="text-muted small italic">Processed</span>');
        } else {
        Swal.fire('Error!', response.message, 'error');
        }
        },
        error: function () {
        Swal.fire('Error!', 'Something went wrong on the server.', 'error');
        }
        });
        }
        });
        });

        
        $('.btn-reject').on('click', function () {
        var button = $(this);
        var id = button.data('id');
        var actionUrl = button.attr('formaction');

        Swal.fire({
        title: 'Reject Request?',
        text: "Are you sure you want to decline this booking allocation?",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc3545',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Yes, Reject!'
        }).then((result) => {
        if (result.isConfirmed) {
        $.ajax({
        url: actionUrl,
        type: 'POST',
        data: { id: id }, 
        success: function (response) {
        if (response.success) {
        Swal.fire('Rejected!', response.message, 'success');
        $('#badge-' + id).removeClass().addClass('badge px-2 py-1 rounded-2 small fw-semibold bg-danger-subtle text-danger border border-danger').text('Cancelled');
        $('#actions-' + id).html('<span class="text-muted small italic">Processed</span>');
        } else {
        Swal.fire('Error!', response.message, 'error');
        }
        },
        error: function () {
        Swal.fire('Error!', 'Something went wrong on the server.', 'error');
        }
        });
        }
        });
        });
        });
    </script>
}