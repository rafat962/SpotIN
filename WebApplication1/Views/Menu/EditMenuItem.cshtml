@model MenuItem
@{
    Layout = "_OwnerLayout";
    ViewData["Title"] = "Edit Menu Item";
    ViewData["PageTitle"] = "Edit Menu Item";
    ViewData["Breadcrumb"] = "SpotIN · Management · Edit Item";
}

<link rel="stylesheet" href="~/css/Menu-theme.css" />

<div class="si-page animate__animated animate__fadeIn">

    <div class="si-page-header">
        <div>
            <span class="si-eyebrow">Edit Item</span>
            <h1>Edit Menu Item</h1>
            <p>Update the name or pricing of your workspace offering below.</p>
        </div>
        <div>
            <a asp-controller="Menu" asp-action="MenuList" class="si-btn si-btn-outline si-btn-lg">
                Back to Menu List
            </a>
        </div>
    </div>

    <div class="si-form-card">
        <div asp-validation-summary="ModelOnly" class="si-validation-summary"></div>

        <form id="editMenuForm" asp-controller="Menu" asp-action="EditMenuItem" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="si-form-row">
                <div class="si-field">
                    <label asp-for="Name">Item Name</label>
                    <input asp-for="Name" required />
                    <span asp-validation-for="Name" class="si-field-error"></span>
                </div>
                <div class="si-field si-field-narrow">
                    <label asp-for="Price">Price (EGP)</label>
                    <input asp-for="Price" type="number" step="0.01" min="0" required />
                    <span asp-validation-for="Price" class="si-field-error"></span>
                </div>
            </div>

            <div class="si-form-actions">
                <a asp-controller="Menu" asp-action="MenuList" class="si-btn si-btn-outline si-btn-lg">
                    Cancel
                </a>
                <button type="submit" class="si-btn si-btn-primary si-btn-lg">
                    Update Item
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
