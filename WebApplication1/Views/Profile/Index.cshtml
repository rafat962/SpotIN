@model WebApplication1.Models.ViewModel.Profile.OwnerProfileViewModel
@{
    Layout = "_OwnerLayout";
    ViewData["Title"] = "Profile";
    ViewData["PageTitle"] = "Owner Profile";
    ViewData["Breadcrumb"] = "SpotIN · Owner Portal · Profile";
}

<div class="container-fluid px-4 py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div asp-validation-summary="All" class="mb-0"></div>
        </div>
    }

    <form asp-controller="Profile" asp-action="Index" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="WorkspaceId" />
        <input type="hidden" asp-for="Email" />

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 rounded-3 h-100">
                    <div class="card-header bg-white border-0 px-4 py-3 border-bottom">
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-person-circle text-primary me-2"></i>Personal Information
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label asp-for="FirstName" class="form-label fw-semibold text-secondary small"></label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="LastName" class="form-label fw-semibold text-secondary small"></label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                        <div class="mb-0">
                            <label class="form-label fw-semibold text-secondary small">Email</label>
                            <input type="email" class="form-control bg-light" value="@Model.Email" readonly />
                            <small class="text-muted">Email cannot be changed from this page.</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card shadow-sm border-0 rounded-3 mb-4">
                    <div class="card-header bg-white border-0 px-4 py-3 border-bottom">
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-building text-primary me-2"></i>Workspace Details
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="WorkspaceName" class="form-label fw-semibold text-secondary small"></label>
                                <input asp-for="WorkspaceName" class="form-control" />
                                <span asp-validation-for="WorkspaceName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Address" class="form-label fw-semibold text-secondary small"></label>
                                <input asp-for="Address" class="form-control" />
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Latitude" class="form-label fw-semibold text-secondary small"></label>
                                <input asp-for="Latitude" type="number" step="any" class="form-control" />
                                <span asp-validation-for="Latitude" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Longitude" class="form-label fw-semibold text-secondary small"></label>
                                <input asp-for="Longitude" type="number" step="any" class="form-control" />
                                <span asp-validation-for="Longitude" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold text-secondary small"></label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="TotalTables" class="form-label fw-semibold text-secondary small"></label>
                                <input asp-for="TotalTables" type="number" min="0" class="form-control" />
                                <span asp-validation-for="TotalTables" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="TotalRooms" class="form-label fw-semibold text-secondary small"></label>
                                <input asp-for="TotalRooms" type="number" min="0" class="form-control" />
                                <span asp-validation-for="TotalRooms" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mt-4 p-3 bg-light rounded-3 border">
                            <span class="d-block fw-semibold text-secondary small mb-3 text-uppercase">Amenities</span>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <div class="form-check">
                                        <input asp-for="HasWiFi" class="form-check-input" />
                                        <label asp-for="HasWiFi" class="form-check-label"></label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-check">
                                        <input asp-for="HasAirConditioning" class="form-check-input" />
                                        <label asp-for="HasAirConditioning" class="form-check-label"></label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-check">
                                        <input asp-for="HasDrinksAndCafeteria" class="form-check-input" />
                                        <label asp-for="HasDrinksAndCafeteria" class="form-check-label"></label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-header bg-white border-0 px-4 py-3 border-bottom d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-grid-3x3-gap text-primary me-2"></i>Tables & Rooms Pricing
                        </h5>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fw-bold">
                            @Model.Resources.Count resources
                        </span>
                    </div>
                    <div class="card-body p-0">
                        @if (Model.Resources == null || !Model.Resources.Any())
                        {
                            <div class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-2 d-block mb-2 opacity-50"></i>
                                No resources configured for this workspace.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light text-secondary fw-bold small">
                                        <tr>
                                            <th class="ps-4 py-3">Resource</th>
                                            <th>Type</th>
                                            <th>Status</th>
                                            <th class="pe-4" style="width: 220px;">Hourly Rate (EGP)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (var i = 0; i < Model.Resources.Count; i++)
                                        {
                                            <tr>
                                                <td class="ps-4">
                                                    <input type="hidden" asp-for="Resources[i].Id" />
                                                    <input type="hidden" asp-for="Resources[i].Type" />
                                                    <input type="hidden" asp-for="Resources[i].IsAvailable" />
                                                    <input asp-for="Resources[i].Name" class="form-control form-control-sm fw-semibold" />
                                                    <span asp-validation-for="Resources[i].Name" class="text-danger small"></span>
                                                </td>
                                                <td>
                                                    <span class="badge @(Model.Resources[i].Type == "Room" ? "bg-info-subtle text-info border border-info" : "bg-secondary-subtle text-secondary border")">
                                                        @Model.Resources[i].Type
                                                    </span>
                                                </td>
                                                <td>
                                                    @if (Model.Resources[i].IsAvailable)
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success">Available</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger border border-danger">Occupied</span>
                                                    }
                                                </td>
                                                <td class="pe-4">
                                                    <div class="input-group input-group-sm">
                                                        <span class="input-group-text bg-light">EGP</span>
                                                        <input asp-for="Resources[i].HourlyRate" type="number" step="0.01" min="0.01" class="form-control" />
                                                    </div>
                                                    <span asp-validation-for="Resources[i].HourlyRate" class="text-danger small"></span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-controller="Owner" asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
            <button type="submit" class="btn btn-primary fw-bold px-4 shadow-sm">
                <i class="bi bi-save me-1"></i> Save Changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
