<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SpotIN</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/client.css" asp-append-version="true" />
</head>
<body>

    <!-- ══════ SIDEBAR ══════ -->
    <aside class="sp-sidebar">

        <a class="sp-brand" href="#">
            <div class="sp-brand-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
                    <circle cx="12" cy="9" r="2.5"/>
                </svg>
            </div>
            <span class="sp-brand-name">spot<span>IN</span></span>
        </a>

        <nav class="sp-nav">
            <div class="sp-nav-section">
                <div class="sp-nav-label">Workspace</div>
                <a href="/Client/Explore" class="sp-nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                        <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
                    </svg>
                    Explore
                </a>
            </div>

            <div class="sp-nav-section">
                <div class="sp-nav-label">My Account</div>
                <a href="/Client/Bookings" class="sp-nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <polyline points="14 2 14 8 20 8"/>
                        <line x1="16" y1="13" x2="8" y2="13"/>
                        <line x1="16" y1="17" x2="8" y2="17"/>
                    </svg>
                    My Bookings
                </a>
            </div>

            <div class="sp-nav-section">
                <div class="sp-nav-label">Settings</div>
                <a href="/Client/Profile" class="sp-nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                    Profile
                </a>
           <a asp-controller="Account" asp-action="Logout" class="sp-nav-item sp-nav-item--danger">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
                Sign out
            </a>
            </div>
        </nav>

        <div class="sp-sidebar-footer">
            <div class="sp-user-mini">
                <div class="sp-avatar">
                    @{
                        var first    = User.FindFirst("FirstName")?.Value ?? "";
                        var last     = User.FindFirst("LastName")?.Value  ?? "";
                        var initials = (first.Length > 0 ? first[0].ToString() : "")
                                     + (last.Length  > 0 ? last[0].ToString()  : "");
                    }
                    @initials.ToUpper()
                </div>
                <div class="sp-user-info">
                    <div class="sp-user-name">@first @last</div>
                    <div class="sp-user-role">Client</div>
                </div>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/>
                </svg>
            </div>
        </div>

    </aside>

    <!-- ══════ MAIN ══════ -->
    <div class="sp-main">

        <nav class="sp-navbar">
            <div>
                <div class="sp-page-title">@(ViewData["PageTitle"] ?? "SpotIN")</div>
                <div class="sp-page-breadcrumb">@(ViewData["Breadcrumb"] ?? "SpotIN · Client Portal")</div>
            </div>

            <div class="sp-navbar-right">

                <div class="sp-search">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    <input type="text" placeholder="Search spaces…" />
                </div>

                <button class="sp-icon-btn" title="Notifications">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                    </svg>
                    <span class="notif-dot"></span>
                </button>

                <div class="sp-navbar-avatar" title="@first @last">@initials.ToUpper()</div>
            </div>
        </nav>

        <main class="sp-content">
            @RenderBody()
        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
