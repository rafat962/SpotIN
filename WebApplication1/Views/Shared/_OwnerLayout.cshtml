<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SpotIN Owner</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/owner.css" asp-append-version="true" />
</head>
<body>

    <!-- ══════ SIDEBAR ══════ -->
    <aside class="ow-sidebar">

        <a class="ow-brand"  asp-controller="Account" asp-action="Login" >
            <div class="ow-brand-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
                    <circle cx="12" cy="9" r="2.5"/>
                </svg>
            </div>
            <div class="ow-brand-text">
                <span class="ow-brand-name">spot<span>IN</span></span>
                <span class="ow-brand-tag">Owner Portal</span>
            </div>
        </a>

        <nav class="ow-nav">
            <div class="ow-nav-section">
                <div class="ow-nav-label">Overview</div>
                <a asp-controller="Account" asp-action="Login"  class="ow-nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                        <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
                    </svg>
                    Dashboard
                </a>
            </div>

            <div class="ow-nav-section">
                <div class="ow-nav-label">Management</div>
                <a asp-controller="Account" asp-action="Login"  class="ow-nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="7" width="20" height="14" rx="2"/>
                        <path d="M16 7V5a2 2 0 0 0-4 0v2M8 7V5a2 2 0 0 1 4 0"/>
                    </svg>
                    Manage Workspaces
                </a>
                <a  asp-controller="Account" asp-action="Login"  class="ow-nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <polyline points="14 2 14 8 20 8"/>
                        <line x1="16" y1="13" x2="8" y2="13"/>
                        <line x1="16" y1="17" x2="8" y2="17"/>
                    </svg>
                    Invoices
                </a>
                <a asp-controller="Account" asp-action="Login"  class="ow-nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8h1a4 4 0 0 1 0 8h-1"/>
                        <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/>
                        <line x1="6" y1="1" x2="6" y2="4"/>
                        <line x1="10" y1="1" x2="10" y2="4"/>
                        <line x1="14" y1="1" x2="14" y2="4"/>
                    </svg>
                    Incoming Requests
                    @if (ViewBag.PendingCount != null && ViewBag.PendingCount > 0)
                    {
                        <span class="ow-nav-badge">@ViewBag.PendingCount</span>
                    }
                </a>
                <a  asp-controller="Account" asp-action="Login"  class="ow-nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="8" y1="6" x2="21" y2="6"/>
                        <line x1="8" y1="12" x2="21" y2="12"/>
                        <line x1="8" y1="18" x2="21" y2="18"/>
                        <line x1="3" y1="6" x2="3.01" y2="6"/>
                        <line x1="3" y1="12" x2="3.01" y2="12"/>
                        <line x1="3" y1="18" x2="3.01" y2="18"/>
                    </svg>
                    Current Menu
                </a>
            </div>

            <div class="ow-nav-section">
                <div class="ow-nav-label">Account</div>
                <a  asp-controller="Account" asp-action="Login"  class="ow-nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                    Profile
                </a>
                <a asp-controller="Account" asp-action="Logout"  class="ow-nav-item ow-nav-item--danger">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                        <polyline points="16 17 21 12 16 7"/>
                        <line x1="21" y1="12" x2="9" y2="12"/>
                    </svg>
                    Sign out
                </a>
            </div>
        </nav>

        <div class="ow-sidebar-footer">
            <div class="ow-user-mini">
                <div class="ow-avatar">
                    @{
                        var first    = User.FindFirst("FirstName")?.Value ?? "";
                        var last     = User.FindFirst("LastName")?.Value  ?? "";
                        var initials = (first.Length > 0 ? first[0].ToString() : "")
                                     + (last.Length  > 0 ? last[0].ToString()  : "");
                    }
                    @initials.ToUpper()
                </div>
                <div class="ow-user-info">
                    <div class="ow-user-name">@first @last</div>
                    <div class="ow-user-role">Owner</div>
                </div>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/>
                </svg>
            </div>
        </div>

    </aside>

    <!-- ══════ MAIN ══════ -->
    <div class="ow-main">

        <nav class="ow-navbar">
            <div>
                <div class="ow-page-title">@(ViewData["PageTitle"] ?? "Dashboard")</div>
                <div class="ow-page-breadcrumb">@(ViewData["Breadcrumb"] ?? "SpotIN · Owner Portal")</div>
            </div>

            <div class="ow-navbar-right">

                <div class="ow-search">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    <input type="text" placeholder="Search…" />
                </div>

                <button class="ow-icon-btn" title="Notifications">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                    </svg>
                    <span class="ow-notif-dot"></span>
                </button>

                <div class="ow-navbar-avatar" title="@first @last">@initials.ToUpper()</div>
            </div>
        </nav>

        <main class="ow-content">
            @RenderBody()
        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
