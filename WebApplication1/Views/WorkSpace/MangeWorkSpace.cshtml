@model WebApplication1.Models.Domain.WorkSpaces.WorkSpace
@{
    Layout = "_OwnerLayout";
    ViewData["Title"]      = "Manage Workspace";
    ViewData["PageTitle"]  = "Manage Workspace";
    ViewData["Breadcrumb"] = "SpotIN . Owner Portal . Manage Workspace";
}

<style>
    .resource-card {
        border: none;
        border-radius: 12px; 
        min-height: 85px; 
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
        cursor: pointer;
        padding: 10px !important; 
    }

    .resource-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
    }

    .status-available { background: linear-gradient(135deg, #20c997 0%, #198754 100%); }
    .status-occupied { background: linear-gradient(135deg, #f87171 0%, #dc3545 100%); }
    .status-pending { background: linear-gradient(135deg, #f6ad55 0%, #ed8936 100%); } 

    .card-title-custom {
        font-weight: 600;
        letter-spacing: 0.5px;
        font-size: 1rem; 
    }

    .custom-modal .modal-content {
        border-radius: 24px;
        border: none;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
    }
    .custom-modal .modal-header {
        border-bottom: none;
        padding: 30px 30px 15px;
    }
    .custom-modal .modal-title {
        font-weight: 700;
        color: #2d3748;
    }
    .custom-modal .modal-body {
        padding: 0 30px 20px;
        color: #4a5568;
    }
    .custom-modal .modal-footer {
        border-top: none;
        padding: 15px 30px 30px;
    }
    .custom-input {
        border-radius: 12px;
        padding: 14px 18px;
        border: 1px solid #e2e8f0;
        background-color: #f8fafc;
        font-size: 0.95rem;
        transition: all 0.3s ease;
    }
    .custom-input:focus {
        border-color: #20c997;
        background-color: #ffffff;
        box-shadow: 0 0 0 4px rgba(32, 201, 151, 0.15);
        outline: none;
    }
    .btn-custom {
        border-radius: 12px;
        padding: 12px 24px;
        font-weight: 600;
        letter-spacing: 0.3px;
        transition: all 0.3s ease;
        border: none;
    }
    .btn-custom:hover {
        transform: translateY(-2px);
    }

    .resource-table {
        border-radius: 8px;
    }

    .resource-room {
        border-radius: 25px;
        border: 2px dashed rgba(255, 255, 255, 0.6);
        transform: scale(1.02); 
    }

    .resource-icon {
        font-size: 1.5rem;
        margin-bottom: 5px;
        opacity: 0.9;
    }

    .modal-alert-container {
        padding: 0 30px;
        margin-top: 10px;
    }

    /* Live floor manage modal */
    .wf-manage-modal .modal-content {
        border-radius: 20px;
        overflow: hidden;
    }

    .wf-modal-header {
        background: linear-gradient(135deg, #f8fafc 0%, #eef2ff 100%);
        border-bottom: 1px solid #e5e7eb;
        padding: 1.25rem 1.5rem;
    }

    .wf-modal-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        color: #fff;
    }

    .wf-modal-icon--busy { background: linear-gradient(135deg, #f87171, #dc3545); }
    .wf-modal-icon--free { background: linear-gradient(135deg, #34d399, #198754); }

    .wf-modal-type {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #6b7280;
        margin-bottom: 0.15rem;
    }

    .wf-modal-body { padding: 1.25rem 1.5rem 0.5rem; }

    .wf-status-panel {
        border-radius: 14px;
        padding: 1rem 1.25rem;
        border: 1px solid transparent;
    }

    .wf-status-panel--occupied {
        background: #fef2f2;
        border-color: #fecaca;
    }

    .wf-status-panel--available {
        background: #ecfdf5;
        border-color: #a7f3d0;
    }

    .wf-checkin-form { min-width: 280px; max-width: 360px; }

    .wf-section-title {
        font-size: 0.85rem;
        font-weight: 700;
        color: #374151;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .wf-orders-box { overflow: hidden; }

    .wf-orders-table thead th {
        background: #f9fafb;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #6b7280;
        border-bottom-width: 1px;
    }

    .wf-bookings-table-wrap {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
    }

    .wf-bookings-table-wrap thead th {
        background: #1f2937;
        color: #fff;
        font-size: 0.78rem;
        font-weight: 600;
        border: none;
    }

    .wf-status-badge { font-weight: 600; }
    .wf-status-badge--active { background: #198754; }
    .wf-status-badge--completed { background: #0d6efd; }
    .wf-status-badge--pending { background: #fd7e14; }

    .wf-modal-footer { padding: 0.75rem 1.5rem 1.25rem; background: #f9fafb; }

    /* Add order modal */
    .wf-add-order-modal .modal-content {
        border-radius: 18px;
        border: none;
        overflow: hidden;
    }

    .wf-add-order-modal .modal-header {
        background: #1f2937;
        color: #fff;
        border: none;
        padding: 1rem 1.25rem;
    }

    .wf-order-row {
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 0.75rem;
    }

    .wf-btn-add-row {
        border-style: dashed;
        border-width: 2px;
        font-weight: 600;
    }
</style>

<div class="container-fluid mt-4">
    <h4 class="mb-4">Live Floor Preview</h4>
    
    @if (Model == null)
    {
        <div class="alert alert-warning">
            No workspace is currently associated with your account.
        </div>
    }
    else
    {
        <div class="mb-4">
            <span class="badge bg-success me-2 p-2">Available</span>
            <span class="badge bg-danger me-2 p-2">Occupied</span>
            <span class="badge bg-warning text-dark p-2">Pending</span> 
        </div>

        <div id="live-floor-container">
            <partial name="_LiveFloor" model="Model" />
        </div>
    }
</div>

<div class="modal fade wf-add-order-modal" id="addOrderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg">
            <form id="addOrderForm" asp-action="AddOrdersToSession" asp-controller="WorkSpace" method="post">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title mb-0">Add Orders</h5>
                        <small class="text-white-50" id="addOrderResourceLabel">Session bill</small>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" id="orderBookingId" name="bookingId" />

                    <div id="orderRowsContainer"></div>

                    <button type="button" class="btn btn-outline-primary btn-sm w-100 mt-3 wf-btn-add-row" id="addOrderRowBtn">
                        <i class="bi bi-plus-lg me-1"></i> Add another item
                    </button>

                    <div id="addOrderAlert" class="alert d-none mt-3 mb-0" role="alert"></div>
                </div>
                <div class="modal-footer border-0 bg-light px-4 py-3">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning fw-bold px-4" id="submitOrdersBtn">
                        <i class="bi bi-bag-plus me-1"></i> Add to Bill
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<template id="orderRowTemplate">
    <div class="wf-order-row mb-2 order-row">
        <div class="row g-2 align-items-end">
            <div class="col-md-7">
                <label class="form-label small fw-semibold text-secondary mb-1">Menu item</label>
                <select name="menuItemId" class="form-select form-select-sm" required>
                    <option value="">Select item...</option>
                    @if (ViewBag.Menu != null)
                    {
                        foreach (var menuItem in ViewBag.Menu)
                        {
                            <option value="@menuItem.Id">@menuItem.Name — @menuItem.Price.ToString("N0") EGP</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary mb-1">Qty</label>
                <input type="number" name="quantity" class="form-control form-control-sm" value="1" min="1" max="100" required />
            </div>
            <div class="col-md-2 d-grid">
                <button type="button" class="btn btn-outline-danger btn-sm remove-order-row" title="Remove row">
                    <i class="bi bi-dash-lg"></i>
                </button>
            </div>
        </div>
    </div>
</template>

<div class="modal fade text-dark" id="invoiceDisplayModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow border-0" id="invoiceModalContent"></div>
    </div>
</div>

@section Scripts {
    <script>
        // دالة إنهاء الجلسة وعرض الفاتورة
        function handleEndSession(event, form) {
            event.preventDefault(); 
            
            const url = form.action;
            const formData = new FormData(form);

            fetch(url, {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // إخفاء موديل إدارة الترابيزة الحالي
                    const currentModalEl = form.closest('.modal');
                    if (currentModalEl) {
                        const currentModal = bootstrap.Modal.getInstance(currentModalEl);
                        if (currentModal) currentModal.hide();
                    }

                    // جلب الفاتورة
                    const getDetailsUrl = `/Invoices/GetDetails/${data.invoiceId}`;

                    fetch(getDetailsUrl, {
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    })
                    .then(res => {
                        if (!res.ok) throw new Error(`Failed to load invoice (${res.status})`);
                        return res.text();
                    })
                    .then(html => {
                        document.getElementById('invoiceModalContent').innerHTML = html;

                        const invoiceModalEl = document.getElementById('invoiceDisplayModal');
                        const invoiceModal = new bootstrap.Modal(invoiceModalEl);
                        invoiceModal.show();

                        invoiceModalEl.addEventListener('hidden.bs.modal', function () {
                            location.reload();
                        }, { once: true });
                    })
                    .catch(err => {
                        console.error('Invoice load error:', err);
                        alert("تم إنهاء الجلسة لكن تعذّر تحميل الفاتورة.");
                        location.reload();
                    });
                } else {
                    alert("حدث خطأ: " + (data.message || "لا يمكن إنهاء الجلسة."));
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert("حدث خطأ أثناء الاتصال بالسيرفر.");
            });
        }

        // دالة فتح موديل إضافة طلبات (صفوف متعددة)
        function openAddOrderModal(bookingId, resourceName) {
            document.getElementById('orderBookingId').value = bookingId;
            document.getElementById('addOrderResourceLabel').textContent = resourceName
                ? `Adding to ${resourceName}`
                : 'Session bill';

            const container = document.getElementById('orderRowsContainer');
            container.innerHTML = '';
            addOrderRow();

            const alertBox = document.getElementById('addOrderAlert');
            alertBox.className = 'alert d-none mt-3 mb-0';

            const orderModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('addOrderModal'));
            orderModal.show();
        }

        function addOrderRow() {
            const template = document.getElementById('orderRowTemplate');
            const container = document.getElementById('orderRowsContainer');
            const clone = template.content.cloneNode(true);
            container.appendChild(clone);
            updateRemoveButtons();
        }

        function updateRemoveButtons() {
            const rows = document.querySelectorAll('#orderRowsContainer .order-row');
            rows.forEach(row => {
                const btn = row.querySelector('.remove-order-row');
                if (btn) btn.disabled = rows.length <= 1;
            });
        }

        document.getElementById('addOrderRowBtn').addEventListener('click', addOrderRow);

        document.getElementById('orderRowsContainer').addEventListener('click', function (e) {
            const removeBtn = e.target.closest('.remove-order-row');
            if (!removeBtn || removeBtn.disabled) return;
            removeBtn.closest('.order-row').remove();
            updateRemoveButtons();
        });

        document.getElementById('addOrderForm').addEventListener('submit', function (e) {
            e.preventDefault();

            const form = e.target;
            const submitBtn = document.getElementById('submitOrdersBtn');
            const alertBox = document.getElementById('addOrderAlert');
            const bookingId = document.getElementById('orderBookingId').value;

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving...';

            fetch(form.action, {
                method: 'POST',
                body: new FormData(form),
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    bootstrap.Modal.getInstance(document.getElementById('addOrderModal')).hide();
                    refreshSessionOrders(bookingId);
                } else {
                    alertBox.textContent = data.message || 'Could not add items.';
                    alertBox.className = 'alert alert-danger mt-3 mb-0';
                }
            })
            .catch(() => {
                alertBox.textContent = 'Connection error. Please try again.';
                alertBox.className = 'alert alert-danger mt-3 mb-0';
            })
            .finally(() => {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="bi bi-bag-plus me-1"></i> Add to Bill';
            });
        });

        function refreshSessionOrders(bookingId) {
            const target = document.getElementById(`session-orders-${bookingId}`);
            if (!target) return;

            fetch(`/WorkSpace/GetSessionOrdersPartial?bookingId=${bookingId}`, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.text())
            .then(html => { target.innerHTML = html; });
        }
    </script>
}